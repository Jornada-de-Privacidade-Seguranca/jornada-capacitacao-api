{
    "name": "jornada/capacitacao-api",
    "type": "project",
    "description": "Backend API for Jornada de Capacitacao para Privacidade e Seguranca.",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.11",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": [
            "@php artisan test"
        ],
        "quality:pint": [
            "@php vendor/bin/pint --test"
        ],
        "quality:phpstan": [
            "@php vendor/bin/phpstan analyse"
        ],
        "quality:phpmd": [
            "@php -d error_reporting=6143 vendor/bin/phpmd app text phpmd.xml",
            "@php -r \"fwrite(STDOUT, 'PHPMD passed.'.PHP_EOL);\""
        ],
        "format": [
            "@php vendor/bin/pint"
        ],
        "quality": [
            "@quality:pint",
            "@quality:phpstan",
            "@quality:phpmd"
        ],
        "check": [
            "@quality",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.6"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
